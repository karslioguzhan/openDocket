# Copy to .env and adjust.

# Comma-free single admin account created on first boot (required for first login).
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-to-a-long-password

# Postgres credentials for the docker-compose stack.
POSTGRES_PASSWORD=opendocket

# Secret used for tokens/sessions. Change to a long random string.
SECRET=change-me

# Public port of the web UI.
PORT=8080

# Set to true when serving over HTTPS behind a TLS terminator.
COOKIE_SECURE=false

# Optional: shared AI provider for the scan-to-contract autofill.
# Any OpenAI-compatible endpoint works. Users can also set their own key
# in the web UI (Settings), which overrides these for their requests.
# OpenCode Zen/Go: LLM_BASE_URL=https://opencode.ai/zen/v1, LLM_MODEL=deepseek-v4-flash
# OpenAI:          LLM_BASE_URL=https://api.openai.com/v1,   LLM_MODEL=gpt-4o-mini
# Local Ollama:    LLM_BASE_URL=http://host.docker.internal:11434/v1, LLM_API_KEY=ollama
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

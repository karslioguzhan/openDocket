# Copy to .env and adjust.

# Comma-free single admin account created on first boot (required for first login).
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-to-a-long-password

# Postgres credentials for the docker-compose stack.
POSTGRES_PASSWORD=opendocket

# Secret used for tokens/sessions. Change to a long random string.
SECRET=change-me

# Public port of the web UI.
PORT=8080

# Set to true when serving over HTTPS behind a TLS terminator.
COOKIE_SECURE=false

# One-click demo account with sample contracts (login screen button).
# Disabled by default: the demo credentials are public, so only enable this on
# an instance you are happy to expose to anonymous visitors.
ENABLE_DEMO=false

# Optional: shared AI provider for the AI features (scan-to-contract autofill
# and the AI Assistant chat). Any OpenAI-compatible endpoint works. Users can
# also set their own key in the web UI (Settings).
# OpenCode Zen/Go: LLM_BASE_URL=https://opencode.ai/zen/v1, LLM_MODEL=deepseek-v4-flash
# OpenAI:          LLM_BASE_URL=https://api.openai.com/v1,   LLM_MODEL=gpt-4o-mini
# Local Ollama:    LLM_BASE_URL=http://host.docker.internal:11434/v1, LLM_API_KEY=ollama
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# Hosts the server is allowed to contact for AI requests. Requests to any other
# host are refused (SSRF protection). Add your own provider's host here.
LLM_ALLOWED_HOSTS=opencode.ai,api.openai.com,openrouter.ai,api.groq.com,api.deepseek.com

# DANGEROUS: allow AI endpoints on any host, including private/loopback
# addresses. Needed for local providers such as Ollama; leave false whenever the
# instance is reachable by other people.
LLM_ALLOW_PRIVATE=false

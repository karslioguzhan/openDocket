# Development environment for the backend (run outside Docker or copy for local dev).

DATABASE_URL=postgresql+asyncpg://opendocket:opendocket@localhost:5432/opendocket
SECRET=dev-secret
FILE_STORAGE_DIR=./data/files
COOKIE_SECURE=false
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin-password-123
AUTO_CREATE_TABLES=true

# Optional shared AI provider (scan-to-contract autofill + AI Assistant chat).
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=
# LLM_MODEL=llama3
# To use a local/private endpoint (e.g. Ollama), either list its host here or
# set LLM_ALLOW_PRIVATE=true. LLM_ALLOW_PRIVATE allows ANY host - only for
# trusted single-user setups.
# LLM_ALLOWED_HOSTS=localhost:11434,host.docker.internal:11434
# LLM_ALLOW_PRIVATE=true

# The demo account is disabled by default; enable it for local development.
# ENABLE_DEMO=true
